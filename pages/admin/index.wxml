<view class="admin-page">
  <view class="admin-nav">
    <button class="close-button" bindtap="closeLogin" aria-label="关闭">×</button>
    <text class="nav-title">{{title}}</text>
  </view>

  <view class="admin-content">
    <view class="auth-card surface">
      <view class="login-illustration">
        <view class="desktop-window">
          <view class="window-toolbar">
            <view class="window-dot"></view>
            <view class="window-dot"></view>
            <view class="window-dot"></view>
          </view>
          <view class="desktop-screen">
            <view class="screen-menu">
              <view class="menu-line active"></view>
              <view class="menu-line"></view>
              <view class="menu-line"></view>
            </view>
            <view class="screen-workspace">
              <image class="desktop-photo" src="../../images/home/build.png" mode="aspectFit"></image>
              <view class="screen-label"></view>
            </view>
          </view>
        </view>
        <view class="desktop-stand"></view>
        <view class="phone-window">
          <view class="phone-speaker"></view>
          <view class="phone-avatar"></view>
          <view class="phone-line"></view>
          <view class="phone-line short"></view>
          <view class="phone-confirm">{{isAuthorized ? '✓' : '→'}}</view>
        </view>
      </view>
      <text class="hero-title">{{isAuthorized ? '登录成功' : '确认登录网页后台'}}</text>
      <view wx:if="{{!isAuthorized}}" class="login-actions">
        <button class="secondary-action cancel-button" disabled="{{submitting}}" bindtap="closeLogin">取消</button>
        <button class="primary-action authorize-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="login">确认登录</button>
      </view>
      <button wx:else class="primary-action return-button" bindtap="closeLogin">返回首页</button>
    </view>
  </view>
</view>
