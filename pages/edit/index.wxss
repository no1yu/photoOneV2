page {
  background: #f6f6f4;
}

.container {
  position: relative;
  box-sizing: border-box;
  width: 100vw;
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.container .photo-edit-content {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  padding: 44rpx 0 36rpx;
  background-color: #f6f6f4;
  background-image: linear-gradient(45deg, #e7e6e2 25%, transparent 25%),
    linear-gradient(-45deg, #e7e6e2 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #e7e6e2 75%),
    linear-gradient(-45deg, transparent 75%, #e7e6e2 75%);
  background-position: 0 0, 0 12rpx, 12rpx -12rpx, -12rpx 0;
  background-size: 24rpx 24rpx;
}

.container .photo-edit-content .canvas-view {
  position: relative;
  z-index: 1;
  box-sizing: content-box;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 12rpx;
  box-shadow: 0 28rpx 70rpx rgba(0, 0, 0, 0.36);
}

.container .photo-edit-content .canvas-view .people-photo {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform-origin: center center;
}

.photo-loading {
  height: 820rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #171717;
  color: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
}

.imgOpt {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: auto;
  margin: 0 28rpx;
  padding: 8rpx 0 0;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 14rpx;
  box-shadow: 0 18rpx 48rpx rgba(16, 16, 16, 0.08);
}

.edit-tabs {
  border-radius: 14rpx;
  overflow: hidden;
}

.imgOpt .colors {
  position: relative;
  z-index: 20;
  box-sizing: border-box;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18rpx;
  padding: 28rpx;
  overflow-x: hidden;
  touch-action: pan-y;
}

.imgOpt .colors .color {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.58);
}

.imgOpt .colors .color:active {
  transform: scale(0.98);
}

.imgOpt .colors .color.transparent {
  background-color: transparent;
  position: relative;
}

.imgOpt .colors .color.transparent::before {
  content: "透明";
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: 1em;
  margin-top: -0.5em;
  color: #333;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}

.custom {
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-bg {
  width: 100%;
  height: 100%;
  background: #171717;
  color: #fff;
  font-size: 24rpx;
  line-height: 104rpx;
  text-align: center;
}

.clothes-panel {
  padding: 24rpx 0 30rpx;
}

.clothes-categories {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx 22rpx;
}

.clothes-category {
  min-width: 118rpx;
  padding: 15rpx 24rpx;
  border: 1rpx solid #dedede;
  border-radius: 999rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}

.clothes-category.active {
  border-color: #171717;
  background: #171717;
  color: #fff;
}

.clothes-scroll {
  box-sizing: border-box;
  width: 100%;
  white-space: nowrap;
}

.clothes-list {
  display: inline-flex;
  gap: 18rpx;
  padding: 0 28rpx 8rpx;
}

.clothes-item {
  position: relative;
  box-sizing: border-box;
  width: 190rpx;
  height: 130rpx;
  flex: 0 0 190rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 3rpx solid transparent;
  border-radius: 12rpx;
  background-color: #f6f6f4;
  background-image: linear-gradient(45deg, #e8e8e6 25%, transparent 25%),
    linear-gradient(-45deg, #e8e8e6 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #e8e8e6 75%),
    linear-gradient(-45deg, transparent 75%, #e8e8e6 75%);
  background-position: 0 0, 0 10rpx, 10rpx -10rpx, -10rpx 0;
  background-size: 20rpx 20rpx;
}

.clothes-item.active {
  border-color: #171717;
}

.clothes-item image {
  width: 100%;
}

.clothes-cancel {
  background: #fff;
  color: #555;
  font-size: 25rpx;
  font-weight: 700;
}

.clothes-cancel.active {
  color: #171717;
}

.advanced-params {
  padding: 22rpx 28rpx 28rpx;
}

.params-wrapper {
  display: flex;
  justify-content: space-between;
  gap: 28rpx;
  flex-wrap: wrap;
}

.left-params,
.right-params {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 280rpx;
}

.param-item {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  margin-bottom: 14rpx;
}

.param-label {
  flex: 0 0 150rpx;
  margin-right: 18rpx;
  color: #555;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.param-input {
  flex: 0 0 116rpx;
  box-sizing: border-box;
  width: 116rpx;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0;
  border: 1rpx solid #dedede;
  border-radius: 10rpx;
  background: #fff;
  color: #171717;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
}

.render-radio-group {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.radio-label {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  color: #555;
  font-size: 27rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.radio-label radio {
  margin-right: 12rpx;
  transform: scale(0.9);
}

.radio-container {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.download-view {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  justify-content: center;
  height: auto;
}

.button-group {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.button-group .save-btn {
  flex: 1;
  width: auto;
}

.button-group .single-btn {
  width: 100%;
}

.download-view button {
  height: 96rpx;
  margin: 0;
  border-radius: 10rpx;
  background-color: #171717 !important;
  color: #fff !important;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.color-picker-view {
  position: absolute;
  width: 100%;
  overflow: visible;
  z-index: 99;
}

.color-picker-view .color-picker-content {
  width: 100%;
  height: 55vh;
  background-color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.color-picker-view .color-picker-content .current-color {
  width: 100%;
}

.color-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.color-picker-view .color-picker-content button {
  margin: 10px auto 0;
  background-color: #171717;
  color: #fff;
}

.nowx_mask {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 99;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
