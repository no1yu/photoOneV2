.home-page {
  min-height: 100vh;
  background: #f6f6f4;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  height: 58vh;
  min-height: 760rpx;
  overflow: hidden;
  background: #111;
}

.hero-swiper,
.hero-image {
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.18) 42%, rgba(0, 0, 0, 0.74) 100%);
  pointer-events: none;
}

.hero-content {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 96rpx;
  color: #fff;
}

.hero-title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.18;
}

.hero-desc {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.6;
}

.quick-panel {
  position: relative;
  z-index: 2;
  margin: -48rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 18rpx;
}

.quick-main {
  display: flex;
  align-items: center;
  min-height: 148rpx;
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid #eeeeec;
}

.quick-main-img {
  width: 116rpx;
  height: 116rpx;
  margin-right: 24rpx;
}

.quick-main-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.quick-title {
  color: #171717;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.quick-desc {
  margin-top: 8rpx;
  color: #858585;
  font-size: 24rpx;
  line-height: 1.45;
}

.quick-arrow {
  color: #1b1b1b;
  font-size: 56rpx;
  line-height: 1;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding-top: 26rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 132rpx;
}

.quick-item image {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 14rpx;
}

.quick-item text {
  color: #303030;
  font-size: 24rpx;
  font-weight: 600;
}

.service-section {
  padding: 40rpx 28rpx 0;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  color: #171717;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #8a8a8a;
  font-size: 24rpx;
}

.section-more {
  color: #171717;
  font-size: 24rpx;
  font-weight: 700;
}

.service-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.service-card {
  position: relative;
  min-height: 330rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.05);
}

.service-cover {
  width: 100%;
  height: 190rpx;
  background: #e8ecef;
}

.service-copy {
  padding: 20rpx 22rpx 24rpx;
}

.service-title,
.service-desc {
  display: block;
}

.service-title {
  color: #171717;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.service-desc {
  margin-top: 6rpx;
  color: #858585;
  font-size: 22rpx;
  line-height: 1.45;
}

.login-prompt {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 26rpx;
}

.login-prompt text {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
  font-size: 26rpx;
  line-height: 1.35;
}

.login-button {
  flex-shrink: 0;
  min-width: 152rpx;
  height: 60rpx;
  margin: 0 30rpx 0 18rpx;
  padding: 0 28rpx;
  border-radius: 50rpx;
  background: #fff;
  color: #171717;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.18);
}

.login-button::after {
  border: none;
}
