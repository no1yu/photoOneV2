page {
  background: #f6f6f4;
}

.explore-handle-page {
  width: 750rpx;
  min-height: 100vh;
  padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
  background: #f6f6f4;
}

.image-section {
  padding: 0;
}

.image-workspace {
  position: relative;
  width: 750rpx;
  height: 780rpx;
  overflow: hidden;
  border: 0;
  border-radius: 0;
  background: #fff;
  box-shadow: none;
}

.result-state .image-workspace {
  height: calc(100vh - 228rpx - env(safe-area-inset-bottom));
  min-height: 680rpx;
}

.workspace-image {
  width: 100%;
  height: 100%;
}

.download-watermark {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 3;
  width: 750rpx;
  pointer-events: none;
  transform: translate(-50%, -50%);
}

.upload-empty {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d5d5d2;
  border-radius: 17rpx;
  background: #fafaf8;
}

.upload-empty text {
  margin-top: 24rpx;
  color: #929292;
  font-size: 29rpx;
  line-height: 1.4;
}

.upload-empty:active {
  background: #f4f4f1;
}

.transparent-workspace {
  background-color: #f6f6f4;
  background-image:
    linear-gradient(45deg, #e7e6e2 25%, transparent 25%),
    linear-gradient(-45deg, #e7e6e2 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #e7e6e2 75%),
    linear-gradient(-45deg, transparent 75%, #e7e6e2 75%);
  background-position: 0 0, 0 12rpx, 12rpx -12rpx, -12rpx 0;
  background-size: 24rpx 24rpx;
}

.processing-workspace {
  background: #f4f4f1;
}

.processing-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sketch-animation {
  position: relative;
  width: 330rpx;
  height: 258rpx;
}

.sketch-line {
  position: absolute;
  z-index: 2;
  border-radius: 999rpx;
  background: #454545;
}

.sketch-line-top,
.sketch-line-bottom {
  left: 0;
  width: 330rpx;
  height: 4rpx;
  transform: scaleX(0);
  transform-origin: left center;
}

.sketch-line-top {
  top: 0;
  animation: draw-horizontal-line 2.8s ease-in-out infinite;
}

.sketch-line-bottom {
  bottom: 0;
  transform-origin: right center;
  animation: draw-horizontal-line 2.8s 1.15s ease-in-out infinite;
}

.sketch-line-left,
.sketch-line-right {
  top: 0;
  width: 4rpx;
  height: 258rpx;
  transform: scaleY(0);
  transform-origin: top center;
}

.sketch-line-right {
  right: 0;
  animation: draw-vertical-line 2.8s 0.55s ease-in-out infinite;
}

.sketch-line-left {
  left: 0;
  transform-origin: bottom center;
  animation: draw-vertical-line 2.8s 1.7s ease-in-out infinite;
}

.sketch-sun {
  position: absolute;
  top: 54rpx;
  right: 62rpx;
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid #777;
  border-radius: 50%;
  opacity: 0;
  animation: reveal-sketch 2.8s 0.85s ease-in-out infinite;
}

.sketch-mountain {
  position: absolute;
  bottom: 50rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #777;
  opacity: 0;
  transform-origin: left center;
  animation: reveal-mountain 2.8s ease-in-out infinite;
}

.sketch-mountain-left {
  left: 54rpx;
  width: 142rpx;
  transform: rotate(-47deg);
  animation-delay: 1.15s;
}

.sketch-mountain-right {
  left: 150rpx;
  width: 126rpx;
  transform: rotate(43deg);
  animation-delay: 1.35s;
}

.sketch-brush {
  position: absolute;
  z-index: 4;
  top: -30rpx;
  left: -28rpx;
  width: 58rpx;
  height: 58rpx;
  animation: move-brush 2.8s ease-in-out infinite;
}

.processing-title {
  margin-top: 54rpx;
  color: #171717;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 4rpx;
}

.processing-dots {
  height: 18rpx;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.processing-dots view {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #777;
  animation: processing-dot 1.2s ease-in-out infinite;
}

.processing-dots view:nth-child(2) {
  animation-delay: 0.16s;
}

.processing-dots view:nth-child(3) {
  animation-delay: 0.32s;
}

.control-panel {
  width: 750rpx;
  margin-top: 22rpx;
  padding: 0 28rpx 38rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-shadow: 0 -8rpx 34rpx rgba(0, 0, 0, 0.045);
}

.control-panel-disabled {
  pointer-events: none;
  opacity: 0.72;
}

.control-panel-simple {
  padding-bottom: 0;
}

.control-panel-simple .file-info-bar {
  border-bottom: 0;
}

.file-info-bar {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eeeeec;
}

.file-info-item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.file-info-center {
  justify-content: center;
}

.file-info-right {
  justify-content: flex-end;
}

.file-info-text {
  overflow: hidden;
  color: #777;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.params-section {
  padding-top: 34rpx;
}

.parameter-row {
  min-height: 96rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.045);
  border-radius: 14rpx;
  background: #f7f7f5;
}

.parameter-row:last-child {
  margin-bottom: 0;
}

.parameter-field {
  min-height: 96rpx !important;
  padding: 24rpx 26rpx !important;
  background: #f7f7f5 !important;
}

.watermark-style-row,
.crop-line-row {
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.parameter-label {
  flex-shrink: 0;
  color: #323233;
  font-size: 28rpx;
}

.inline-option-block {
  margin-bottom: 18rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.045);
  border-radius: 14rpx;
  background: #f7f7f5;
}

.inline-option-title {
  color: #323233;
  font-size: 28rpx;
  font-weight: 600;
}

.format-options {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.layout-options {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.format-option,
.layout-option {
  height: 72rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 10rpx;
  background: #fff;
  color: #555;
  font-size: 25rpx;
  line-height: 72rpx;
  text-align: center;
}

.format-option.active,
.layout-option.active {
  border-color: #171717;
  background: #171717;
  color: #fff;
  font-weight: 700;
}

.template-options {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.template-option {
  height: 76rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 10rpx;
  background: #fff;
  color: #555;
  font-size: 26rpx;
  line-height: 76rpx;
  text-align: center;
}

.template-option.active {
  border-color: #171717;
  background: #171717;
  color: #fff;
  font-weight: 700;
}

.template-preview {
  height: 340rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 12rpx;
  background: #efefec;
}

.template-preview-image {
  width: 100%;
  height: 100%;
}

.color-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.custom-color-button {
  width: 142rpx;
  height: 64rpx;
  margin: 0 0 0 auto;
  padding: 0;
  flex-shrink: 0;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 9rpx;
  background: #fff;
  color: #171717;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: center;
}

.custom-color-button:active {
  background: #ededeb;
}

.color-options {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
}

.color-option {
  width: 72rpx;
  height: 72rpx;
  justify-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 0, 0, 0.14);
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.48);
}

.color-option.active {
  border-color: #171717;
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 5rpx #171717;
}

.couple-color-options {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20rpx 14rpx;
}

.couple-color-option {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: #666;
  font-size: 23rpx;
}

.couple-color-preview {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 0, 0, 0.14);
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.42);
}

.couple-color-option.active {
  color: #171717;
  font-weight: 700;
}

.couple-color-option.active .couple-color-preview {
  border-color: #171717;
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 5rpx #171717;
}

.watermark-style-options {
  display: flex;
  padding: 6rpx;
  border-radius: 11rpx;
  background: #e9e9e6;
}

.watermark-style-option {
  min-width: 130rpx;
  height: 58rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  color: #6f6f6f;
  font-size: 24rpx;
  line-height: 58rpx;
  text-align: center;
}

.watermark-style-option.active {
  background: #171717;
  color: #fff;
}

.page-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  gap: 18rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 246, 244, 0.97);
}

.footer-button {
  flex: 1;
  height: 96rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
}

.single-button {
  width: 100%;
}

.primary-button {
  background: #171717;
  color: #fff;
}

.secondary-button {
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  background: #fff;
  color: #171717;
}

.button-processing {
  background: #3d3d3d;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.16);
}

.button-processing-content {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.button-processing-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: button-processing-spin 0.8s linear infinite;
}

.primary-button:active,
.secondary-button:active {
  opacity: 0.82;
}

@keyframes draw-horizontal-line {
  0%,
  8% {
    transform: scaleX(0);
  }

  34%,
  88% {
    transform: scaleX(1);
  }

  100% {
    transform: scaleX(0);
  }
}

@keyframes draw-vertical-line {
  0%,
  18% {
    transform: scaleY(0);
  }

  46%,
  88% {
    transform: scaleY(1);
  }

  100% {
    transform: scaleY(0);
  }
}

@keyframes reveal-sketch {
  0%,
  30% {
    opacity: 0;
    transform: scale(0.55);
  }

  52%,
  88% {
    opacity: 1;
    transform: scale(1);
  }

  100% {
    opacity: 0;
    transform: scale(0.75);
  }
}

@keyframes reveal-mountain {
  0%,
  38% {
    opacity: 0;
  }

  58%,
  88% {
    opacity: 1;
  }

  100% {
    opacity: 0;
  }
}

@keyframes move-brush {
  0% {
    top: -30rpx;
    left: -28rpx;
    transform: rotate(-16deg);
  }

  24% {
    top: -30rpx;
    left: 302rpx;
    transform: rotate(8deg);
  }

  45% {
    top: 225rpx;
    left: 302rpx;
    transform: rotate(30deg);
  }

  68% {
    top: 225rpx;
    left: -28rpx;
    transform: rotate(12deg);
  }

  88% {
    top: -30rpx;
    left: -28rpx;
    transform: rotate(-16deg);
  }

  100% {
    top: -30rpx;
    left: -28rpx;
    transform: rotate(-16deg);
  }
}

@keyframes processing-dot {
  0%,
  60%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }

  30% {
    opacity: 1;
    transform: translateY(-8rpx);
  }
}

@keyframes button-processing-spin {
  to {
    transform: rotate(360deg);
  }
}
