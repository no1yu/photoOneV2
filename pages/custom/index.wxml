<view class="custom-page">
  <view class="page-header">
    <text class="page-title">定制专属证件照规格</text>
    <text class="page-desc">输入像素和DPI，系统会自动估算毫米尺寸</text>
  </view>

  <view class="preview-card surface">
    <view class="preview-frame">
      <text>{{px}}</text>
      <text>{{size}}</text>
    </view>
    <view class="preview-info">
      <text class="preview-title">{{name || '未命名规格'}}</text>
      <text class="preview-desc">专属于我自已的证件照尺寸</text>
    </view>
  </view>

  <view class="form-card surface">
    <van-cell-group border="{{false}}">
      <van-field value="{{name}}" type="text" label="名称" placeholder="请输入名称" border size="large" maxlength="10" input-align="right" bind:input="changeName" />
      <van-field value="{{width}}" type="number" label="宽度" placeholder="像素 px" border size="large" maxlength="4" input-align="right" bind:input="changeWidth" />
      <van-field value="{{height}}" type="number" label="高度" placeholder="像素 px" border size="large" maxlength="4" input-align="right" bind:input="changeHeight" />
      <van-field value="{{dpi}}" type="number" label="分辨率" placeholder="DPI" border size="large" maxlength="4" input-align="right" bind:input="changeDpi" />
      <van-field value="{{size}}" type="text" label="尺寸" readonly border size="large" input-align="right" />
      <van-field value="{{px}}" type="text" label="像素" readonly border="{{false}}" size="large" input-align="right" />
    </van-cell-group>
  </view>

  <view class="bottom-bar">
    <button bindtap="addSize" class="save-button">保存尺寸</button>
  </view>
</view>
