.custom-page {
  min-height: 100vh;
  background: #f6f6f4;
  padding: 36rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 4rpx 4rpx 28rpx;
}

.page-title {
  display: block;
  color: #171717;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-desc {
  display: block;
  margin-top: 14rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 1.6;
}

.preview-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.preview-frame {
  width: 154rpx;
  height: 204rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #fff, #f2f2ef);
  border: 1rpx solid #e8e8e4;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-right: 26rpx;
}

.preview-frame text:first-child {
  color: #171717;
  font-size: 26rpx;
  font-weight: 800;
}

.preview-frame text:last-child {
  margin-top: 10rpx;
  color: #8a8a8a;
  font-size: 20rpx;
}

.preview-info {
  flex: 1;
  min-width: 0;
}

.preview-title {
  display: block;
  color: #171717;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.preview-desc {
  display: block;
  margin-top: 10rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 1.55;
}

.form-card {
  overflow: hidden;
  padding: 8rpx 0;
}

.van-cell {
  padding-left: 28rpx !important;
  padding-right: 28rpx !important;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 246, 244, 0.96);
  z-index: 20;
}

.save-button {
  width: 100%;
  height: 96rpx;
  border-radius: 10rpx;
  background: #171717;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.save-button:active {
  opacity: 0.82;
}
