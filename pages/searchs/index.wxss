page {
  height: 100vh;
  overflow: hidden;
}

.search-page {
  height: 100vh;
  background: #f6f6f4;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-header {
  flex-shrink: 0;
  padding: 34rpx 28rpx 18rpx;
  background: #f6f6f4;
}

.page-title {
  display: block;
  color: #171717;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7b7b7b;
  font-size: 24rpx;
  line-height: 1.5;
}

.search-card {
  flex-shrink: 0;
  margin: 0 28rpx 18rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.05);
}

.van-search {
  background: #fff !important;
}

.van-search__content {
  background: #f6f6f4 !important;
}

.container {
  flex: 1;
  height: auto;
  min-height: 0;
  background: #f6f6f4;
}

.grid-container {
  padding: 22rpx 28rpx 18rpx;
}

.grid-item {
  display: flex;
  align-items: center;
  min-height: 164rpx;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.05);
}

.thumb {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
}

.grid-image {
  width: 74rpx;
  height: 74rpx;
}

.grid-content {
  flex: 1;
  min-width: 0;
}

.title {
  color: #171717;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.description {
  margin-top: 6rpx;
  color: #555;
  font-size: 24rpx;
  line-height: 1.45;
}

.description.muted {
  color: #969696;
}

.arrow {
  color: #171717;
  font-size: 48rpx;
  line-height: 1;
  margin-left: 12rpx;
}

.empty-state {
  padding: 110rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-state image {
  width: 320rpx;
  height: 320rpx;
  opacity: 0.72;
}

.empty-state text {
  margin-top: 24rpx;
  color: #999;
  font-size: 26rpx;
}

.scroll-to-top {
  position: fixed;
  right: 26rpx;
  bottom: calc(58rpx + env(safe-area-inset-bottom));
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #171717;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.18);
}

.scroll-to-top:active {
  opacity: 0.82;
}

.list-status {
  padding: 18rpx 28rpx 42rpx;
  color: #969696;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}
